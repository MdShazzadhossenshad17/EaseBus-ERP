{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "pages/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/pages/(.*)",
      "dest": "/pages/$1"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/login",
      "dest": "/login.php"
    },
    {
      "src": "/register",
      "dest": "/register.php"
    },
    {
      "src": "/app",
      "dest": "/pages/app.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}