// ============================================================
// PART 19: BOOTSTRAP
// ============================================================

document.addEventListener('DOMContentLoaded', () => {
    const userRole = localStorage.getItem('userRole');
    navigateTo(userRole ? 'dashboard' : 'login');

    fetchDataFromServer();
    setupRealtimeConnection();

    // Investor search inputs (both top bar and table)
    const invSearchTop   = document.getElementById('investor-search-top');
    const invSearchTable = document.getElementById('investor-search-table');
    const syncSearch = (src, dst) => {
        if (src) src.addEventListener('input', e => { if (dst) dst.value = e.target.value; filterInvestorsTable(e.target.value); });
    };
    syncSearch(invSearchTop, invSearchTable);
    syncSearch(invSearchTable, invSearchTop);

    // Ledger search + filters
    ['ledger-search', 'filter-type', 'filter-status', 'filter-date', 'btn-apply-filters'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener(id.startsWith('btn') ? 'click' : 'input change', filterLedgerTable);
    });

    // Wire profile nav links
    document.querySelectorAll('aside a, nav a, nav li').forEach(el => {
        const text    = el.textContent.trim().toLowerCase();
        const iconEl  = el.querySelector('.material-symbols-outlined');
        const iconTxt = iconEl ? iconEl.textContent.trim().toLowerCase() : '';

        if (text === 'profile' || iconTxt === 'person') {
            el.setAttribute('href', 'javascript:void(0)'); el.setAttribute('onclick', "navigateTo('profile')"); el.setAttribute('data-nav', 'profile');
        }
        if (text === 'settings' || iconTxt === 'settings') {
            el.setAttribute('href', 'javascript:void(0)'); el.setAttribute('onclick', "navigateTo('settings')"); el.setAttribute('data-nav', 'settings');
        }
        if (text === 'support' || iconTxt === 'help_outline' || iconTxt === 'help') {
            el.style.cursor = 'pointer'; el.setAttribute('onclick', 'openSupportModal()');
        }
    });

    // Older dashboard sidebars use list items rather than links. Give every
    // router control a navigation key so the active item is updated correctly.
    document.querySelectorAll('[onclick*="navigateTo("]').forEach(el => {
        if (el.dataset.nav) return;
        const target = el.getAttribute('onclick').match(/navigateTo\('([^']+)'\)/)?.[1];
        if (target) el.dataset.nav = target;
    });

    // Header icons
    document.querySelectorAll('header button').forEach(btn => {
        const icon = btn.querySelector('.material-symbols-outlined');
        if (!icon) return;
        const t = icon.textContent.trim();
        if (t === 'settings')      btn.onclick = () => navigateTo('settings');
        if (t === 'notifications') btn.onclick = () => showToast('No new notifications.', 'success');
    });
    document.querySelectorAll('header img[alt="User profile"]').forEach(img => {
        img.onclick = () => navigateTo('profile');
        img.classList.add('cursor-pointer');
    });

    // Logout links
    document.querySelectorAll('[href="javascript:signOut()"]').forEach(el => {
        el.setAttribute('href', 'javascript:void(0)'); el.setAttribute('onclick', 'signOut()');
    });

    // Inject "Add Position" button into portfolio if missing
    const portfolioActions = document.querySelector('#screen-portfolio main > .mb-xl > .flex.gap-sm');
    if (portfolioActions && !portfolioActions.querySelector('[data-action="add-position"]')) {
        const btn = document.createElement('button');
        btn.setAttribute('onclick', 'showAddInvestmentModal()');
        btn.setAttribute('data-action', 'add-position');
        btn.className = 'px-md py-xs bg-secondary text-on-secondary rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity shadow-sm flex items-center gap-xs';
        btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">add</span> Add Position';
        portfolioActions.insertBefore(btn, portfolioActions.firstChild);
    }
});
