            <button onclick="closeModal('support')" class="text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="space-y-md">
            <div class="bg-surface-container-low border border-outline-variant rounded-lg p-md">
                <p class="font-body-sm text-body-sm font-bold text-on-surface mb-xs">WealthOffice Platform Support</p>
                <p class="font-body-sm text-body-sm text-on-surface-variant mb-sm">For technical issues, data inquiries, or account management, contact your dedicated relationship manager.</p>
                <div class="space-y-xs">
                    <div class="flex items-center gap-sm">
                        <span class="material-symbols-outlined text-secondary text-[18px]">email</span>
                        <span class="font-label-caps text-label-caps text-on-surface">shad2004@gmail.com</span>
                    </div>
                    <div class="flex items-center gap-sm">
                        <span class="material-symbols-outlined text-secondary text-[18px]">phone</span>
                        <span class="font-label-caps text-label-caps text-on-surface">01521582448</span>
                    </div>
                </div>
            </div>
            <div class="bg-surface-container-low border border-outline-variant rounded-lg p-md">
                <p class="font-body-sm text-body-sm font-bold text-on-surface mb-xs">Platform Information</p>
                <p class="font-body-sm text-body-sm text-on-surface-variant">WealthOffice Institutional Access — Real-time investment management and reporting platform for accredited investors and fund managers.</p>
            </div>
            <button onclick="closeModal('support')" class="w-full py-sm bg-primary text-on-primary rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Close</button>
        </div>
    </div>
</div>

<!-- Modal: Add Investment Position -->
<div id="modal-add-investment" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-50 transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-md max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center pb-sm border-b border-outline-variant mb-md">
            <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Add Investment Position</h3>
            <button onclick="closeModal('add-investment')" class="text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form id="form-add-investment" onsubmit="handleNewInvestmentSubmit(event)" class="space-y-sm">
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Asset Name</label>
                <input required id="new-inv-asset-name" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="text" placeholder="e.g. Acme Corp LP">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Asset Type</label>
                <select id="new-inv-asset-type" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <option value="Private Equity">Private Equity</option>
                    <option value="Venture Capital">Venture Capital</option>
                    <option value="Real Estate">Real Estate</option>
                    <option value="Infrastructure">Infrastructure</option>
                    <option value="Hedge Fund">Hedge Fund</option>
                </select>
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Committed Amount ($)</label>
                <input required id="new-inv-asset-amount" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="number" min="1" placeholder="e.g. 10000000">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Current Market Value ($)</label>
                <input required id="new-inv-asset-value" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="number" min="0" placeholder="e.g. 12000000">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Linked Investor</label>
                <select id="new-inv-asset-investor" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <!-- Populated dynamically -->
                </select>
            </div>
            <div class="flex gap-sm pt-md border-t border-outline-variant mt-md">
                <button type="button" onclick="closeModal('add-investment')" class="flex-1 py-sm border border-outline-variant rounded font-label-caps text-label-caps text-on-surface hover:bg-surface-container-low transition-colors">Cancel</button>
                <button type="submit" class="flex-1 py-sm bg-primary text-on-primary rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Save Position</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Request Capital Call -->
<div id="modal-request-capital-call" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-50 transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-md max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center pb-sm border-b border-outline-variant mb-md">
            <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Request Capital Call</h3>
            <button onclick="closeModal('request-capital-call')" class="text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form id="form-request-capital-call" onsubmit="handleCapitalCallSubmit(event)" class="space-y-sm">
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Select Fund</label>
                <select required id="new-cc-fund" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <!-- Populated dynamically -->
                </select>
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Target Investor</label>
                <select id="new-cc-investor" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <option value="">All Investors</option>
                    <!-- Populated dynamically -->
                </select>
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Call Amount ($)</label>
                <input required id="new-cc-amount" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="number" min="1" placeholder="e.g. 15000000">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Due Date</label>
                <input required id="new-cc-due-date" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="date">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Description</label>
                <input id="new-cc-description" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="text" placeholder="e.g. Draw for Acquisition">
            </div>
            <div class="flex gap-sm pt-md border-t border-outline-variant mt-md">
                <button type="button" onclick="closeModal('request-capital-call')" class="flex-1 py-sm border border-outline-variant rounded font-label-caps text-label-caps text-on-surface hover:bg-surface-container-low transition-colors">Cancel</button>
                <button type="submit" class="flex-1 py-sm bg-primary text-on-primary rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Submit Capital Call</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Edit Investor -->
<div id="modal-edit-investor" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-50 transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-md max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center pb-sm border-b border-outline-variant mb-md">
            <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Edit Investor</h3>
            <button onclick="closeModal('edit-investor')" class="text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form id="form-edit-investor" onsubmit="handleEditInvestorSubmit(event)" class="space-y-sm">
            <input type="hidden" id="edit-inv-id">
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Full Name</label>
                <input required id="edit-inv-name" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="text">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Investor Type</label>
                <select id="edit-inv-type" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <option value="Institutional">Institutional</option>
                    <option value="Family Office">Family Office</option>
                    <option value="Retail">Retail</option>
                </select>
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Email Address</label>
                <input required id="edit-inv-email" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="email">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Phone Number</label>
                <input required id="edit-inv-phone" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="tel">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Commitment Amount ($)</label>
                <input required id="edit-inv-commitment" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="number" min="1">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Link User Account</label>
                <select id="edit-inv-user-id" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <option value="">-- Unlinked / No Portal Access --</option>
                    <!-- Populated dynamically -->
                </select>
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Status</label>
                <select id="edit-inv-status" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <option value="Active">Active</option>
                    <option value="Pending">Pending</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
            <div class="flex gap-sm pt-md border-t border-outline-variant mt-md">
                <button type="button" onclick="closeModal('edit-investor')" class="flex-1 py-sm border border-outline-variant rounded font-label-caps text-label-caps text-on-surface hover:bg-surface-container-low transition-colors">Cancel</button>
                <button type="submit" class="flex-1 py-sm bg-primary text-on-primary rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: View Investor Details -->
<div id="modal-view-investor" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-50 transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-md">
        <div class="flex justify-between items-center pb-sm border-b border-outline-variant mb-md">
            <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Investor details</h3>
            <button onclick="closeModal('view-investor')" class="text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div id="investor-detail-content" class="space-y-md">
            <!-- Loaded dynamically -->
        </div>
        <div class="flex pt-md border-t border-outline-variant mt-md">
            <button onclick="closeModal('view-investor')" class="flex-grow py-sm bg-primary text-on-primary rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Close</button>
        </div>
    </div>
</div>

<!-- Modal: Investor Filter -->
<div id="modal-investor-filter" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-50 transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-md">
        <div class="flex justify-between items-center pb-sm border-b border-outline-variant mb-md">
            <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Filter Investors</h3>
            <button onclick="closeModal('investor-filter')" class="text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="space-y-sm">
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Status</label>
                <select id="filter-inv-status" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Pending">Pending</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Investor Type</label>
                <select id="filter-inv-type" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <option value="">All Types</option>
                    <option value="Institutional">Institutional</option>
                    <option value="Family Office">Family Office</option>
                    <option value="Retail">Retail</option>
                </select>
            </div>
        </div>
        <div class="flex gap-sm pt-md border-t border-outline-variant mt-md">
            <button onclick="resetInvestorFilters()" class="flex-1 py-sm border border-outline-variant rounded font-label-caps text-label-caps text-on-surface hover:bg-surface-container-low transition-colors">Reset</button>
            <button onclick="applyInvestorFilters()" class="flex-1 py-sm bg-primary text-on-primary rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Apply Filters</button>
        </div>
    </div>
</div>

<!-- Modal: Confirm Deactivate -->
<div id="modal-confirm-deactivate" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-[60] transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-sm">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold mb-xs">Deactivate Investor</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant mb-md">Are you sure you want to deactivate this investor? They will be marked as Inactive.</p>
        <input type="hidden" id="confirm-deactivate-id">
        <div class="flex gap-sm">
            <button onclick="closeModal('confirm-deactivate')" class="flex-1 py-sm border border-outline-variant rounded font-label-caps text-label-caps text-on-surface hover:bg-surface-container-low transition-colors">Cancel</button>
            <button onclick="submitCustomDeactivate()" class="flex-1 py-sm bg-[#ba1a1a] text-white rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Deactivate</button>
        </div>
    </div>
</div>

<!-- Modal: Confirm Delete -->
<div id="modal-confirm-delete" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-[60] transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-sm">
        <h3 class="font-headline-sm text-headline-sm text-[#ba1a1a] font-bold mb-xs">Delete Investor</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant mb-md">Are you sure you want to permanently delete this investor and all their financial records? This action cannot be undone.</p>
        <input type="hidden" id="confirm-delete-id">
        <div class="flex gap-sm">
            <button onclick="closeModal('confirm-delete')" class="flex-1 py-sm border border-outline-variant rounded font-label-caps text-label-caps text-on-surface hover:bg-surface-container-low transition-colors">Cancel</button>
            <button onclick="submitCustomDelete()" class="flex-1 py-sm bg-[#ba1a1a] text-white rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Delete Permanently</button>
        </div>
    </div>
</div>

<!-- Modal: Confirm Seed -->
<div id="modal-confirm-seed" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-[60] transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-sm">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold mb-xs">Load Seed Data</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant mb-md">Load default seed data? This will overwrite the current database.</p>
        <div class="flex gap-sm">
            <button onclick="closeModal('confirm-seed')" class="flex-1 py-sm border border-outline-variant rounded font-label-caps text-label-caps text-on-surface hover:bg-surface-container-low transition-colors">Cancel</button>
            <button onclick="submitCustomSeed()" class="flex-1 py-sm bg-primary text-on-primary rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Load Seed</button>
        </div>
    </div>
</div>

<!-- Modal: Confirm Reset -->
<div id="modal-confirm-reset" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-[60] transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-sm">
        <h3 class="font-headline-sm text-headline-sm text-[#ba1a1a] font-bold mb-xs">Reset Database</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant mb-md">Reset database to empty? ALL records will be deleted.</p>
        <div class="flex gap-sm">
            <button onclick="closeModal('confirm-reset')" class="flex-1 py-sm border border-outline-variant rounded font-label-caps text-label-caps text-on-surface hover:bg-surface-container-low transition-colors">Cancel</button>
            <button onclick="submitCustomReset()" class="flex-1 py-sm bg-[#ba1a1a] text-white rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Reset All</button>
        </div>
    </div>
</div>

<!-- Modal: Confirm Clear Activities -->
<div id="modal-confirm-clear-activities" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-[60] transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-sm">
        <h3 class="font-headline-sm text-headline-sm text-[#ba1a1a] font-bold mb-xs">Clear Activities</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant mb-md">Are you sure you want to clear all recent activities and logs?</p>
        <div class="flex gap-sm">
            <button onclick="closeModal('confirm-clear-activities')" class="flex-1 py-sm border border-outline-variant rounded font-label-caps text-label-caps text-on-surface hover:bg-surface-container-low transition-colors">Cancel</button>
            <button onclick="submitCustomClearActivities()" class="flex-1 py-sm bg-[#ba1a1a] text-white rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Clear Logs</button>
        </div>
    </div>
</div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-grid-gutter right-grid-gutter z-[9999] flex flex-col gap-xs pointer-events-none"></div>

    <!-- Consolidated Script -->
    <script src="java.js"></script>
</body>
</html>
