<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>WealthOffice - Institutional Access</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-surface-variant": "#45464d",
                        "surface-container-lowest": "#ffffff",
                        "on-error-container": "#93000a",
                        "surface-container": "#e5eeff",
                        "tertiary-container": "#002113",
                        "primary-fixed-dim": "#bec6e0",
                        "error": "#ba1a1a",
                        "on-secondary-fixed": "#00174b",
                        "background": "#f8f9ff",
                        "on-secondary": "#ffffff",
                        "on-primary": "#ffffff",
                        "surface-container-low": "#eff4ff",
                        "on-primary-fixed": "#131b2e",
                        "secondary-fixed": "#dbe1ff",
                        "on-surface": "#0b1c30",
                        "on-background": "#0b1c30",
                        "tertiary-fixed-dim": "#4edea3",
                        "tertiary-fixed": "#6ffbbe",
                        "primary-fixed": "#dae2fd",
                        "surface-variant": "#d3e4fe",
                        "secondary-container": "#316bf3",
                        "primary-container": "#131b2e",
                        "on-tertiary": "#ffffff",
                        "tertiary": "#000000",
                        "on-tertiary-fixed-variant": "#005236",
                        "on-secondary-container": "#fefcff",
                        "on-secondary-fixed-variant": "#003ea8",
                        "on-tertiary-fixed": "#002113",
                        "on-error": "#ffffff",
                        "surface-container-high": "#dce9ff",
                        "surface-bright": "#f8f9ff",
                        "on-tertiary-container": "#009668",
                        "secondary": "#0051d5",
                        "surface": "#f8f9ff",
                        "surface-tint": "#565e74",
                        "outline-variant": "#c6c6cd",
                        "inverse-primary": "#bec6e0",
                        "inverse-on-surface": "#eaf1ff",
                        "primary": "#000000",
                        "surface-dim": "#cbdbf5",
                        "surface-container-highest": "#d3e4fe",
                        "on-primary-container": "#7c839b",
                        "outline": "#76777d",
                        "secondary-fixed-dim": "#b4c5ff",
                        "on-primary-fixed-variant": "#3f465c",
                        "error-container": "#ffdad6",
                        "inverse-surface": "#213145"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "grid-margin": "32px",
                        "grid-gutter": "20px",
                        "xs": "8px",
                        "lg": "24px",
                        "md": "16px",
                        "2xl": "48px",
                        "sm": "12px",
                        "3xl": "64px",
                        "base": "4px",
                        "xl": "32px"
                    },
                    "fontFamily": {
                        "body-md": ["Inter"],
                        "headline-lg-mobile": ["Geist"],
                        "data-mono": ["JetBrains Mono"],
                        "headline-md": ["Geist"],
                        "body-sm": ["Inter"],
                        "label-caps": ["Inter"],
                        "headline-lg": ["Geist"],
                        "body-lg": ["Inter"],
                        "display-lg": ["Geist"],
                        "headline-sm": ["Geist"]
                    }
                }
            }
        };
    </script>
    <!-- Google Fonts & Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <!-- Consolidated Stylesheet -->
    <link href="design.css" rel="stylesheet">
</head>
<body class="bg-background text-on-background font-body-md antialiased min-h-screen">

<!-- Screen: login -->
<div id="screen-login" class="spa-screen hidden">
<!-- Split Screen Layout -->
<div class="flex w-full min-h-screen">
<!-- Left Column: Branding / Image -->
<div class="hidden lg:flex lg:w-1/2 relative bg-surface-container-highest overflow-hidden">
<!-- Background Image -->
<div class="absolute inset-0 bg-cover bg-center" data-alt="A striking architectural photograph of a modern glass and steel skyscraper reaching towards a clear blue sky, viewed from a low angle. The building reflects sunlight, creating a high-key, pristine aesthetic. The composition emphasizes geometric precision and structural integrity, conveying a sense of corporate authority, stability, and institutional trust. The color palette features cool slate grays, bright whites, and deep navy accents, perfectly aligning with a premium financial brand. The mood is calm, professional, and forward-looking." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAbBsGpEg5dkIzL-qb7cUrqeeNwTREUsv9uE4r6GY2BhHvM-gYBGZDAyH2XhmHVvQwJIagm2mXS0ZyiHHF0fXMu1QZACJOEzHVpK7RlGdiR1e_ucLgceb0eeO-vV0Ru1wwdBgyJXiaQa528ICvmhZwdamnK0wJTkBzT62v4bjoJf-g-fZHz7QcUbX4AgCLm95UdVaL5iX9VJ_wZlwAHVNDFHDFv1IeNG2z2eO_1uaPkxPtEn07F6CmMNA')">
<!-- Overlay for readability if text is added over it, though design specifies clean split -->
<div class="absolute inset-0 bg-primary/10"></div>
</div>
<!-- Brand Overlay on Image -->
<div class="relative z-10 flex flex-col justify-between p-grid-margin h-full">
<div class="flex items-center gap-xs">
<span class="material-symbols-outlined text-primary text-3xl font-variation-settings: 'FILL' 1;">account_balance</span>
<h1 class="text-headline-md font-headline-md text-primary tracking-tight font-semibold">WealthOffice</h1>
</div>
<div class="max-w-md">
<h2 class="text-headline-lg font-headline-lg text-primary mb-md">Institutional Precision.</h2>
<p class="text-body-lg font-body-lg text-on-surface-variant">Navigate complex financial landscapes with clarity, security, and unyielding control.</p>
</div>
</div>
</div>
<!-- Right Column: Login Form -->
<div class="w-full lg:w-1/2 flex items-center justify-center p-md sm:p-grid-margin bg-surface-container-lowest relative">
<!-- Mobile Brand Header (Visible only on mobile) -->
<div class="absolute top-grid-margin left-grid-margin lg:hidden flex items-center gap-xs">
<span class="material-symbols-outlined text-primary text-2xl font-variation-settings: 'FILL' 1;">account_balance</span>
<h1 class="text-headline-sm font-headline-sm text-primary font-semibold">WealthOffice</h1>
</div>
<div class="w-full max-w-md">
<div class="mb-lg">
<h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg-mobile md:font-headline-lg text-on-background mb-xs">Sign In</h2>
<p class="text-body-md font-body-md text-on-surface-variant">Access your institutional portal.</p>
</div>
<form class="space-y-md" id="login-form" onsubmit="event.preventDefault(); signIn(document.getElementById('email').value, document.getElementById('password').value);">
<!-- Email Field -->
<div>
<label class="block text-body-sm font-body-sm font-semibold text-on-background mb-xs" for="email">Corporate Email / Username</label>
<div class="relative">
<span class="absolute inset-y-0 left-0 flex items-center pl-sm pointer-events-none">
<span class="material-symbols-outlined text-outline text-opacity-70 text-[20px]">mail</span>
</span>
<input class="w-full bg-surface-container-lowest border border-outline-variant text-on-background text-body-md font-body-md rounded-DEFAULT pl-xl pr-sm py-sm outline-none transition-all duration-200 input-focused-state" id="email" name="email" placeholder="Enter your email" required="" type="text" value="">
</div>
</div>
<!-- Password Field -->
<div>
<div class="flex justify-between items-baseline mb-xs">
<label class="block text-body-sm font-body-sm font-semibold text-on-background" for="password">Password</label>
<a class="text-label-caps font-label-caps text-secondary hover:text-on-secondary-fixed-variant transition-colors duration-200" href="#">Forgot Password?</a>
</div>
<div class="relative">
<span class="absolute inset-y-0 left-0 flex items-center pl-sm pointer-events-none">
<span class="material-symbols-outlined text-outline text-opacity-70 text-[20px]">lock</span>
</span>
<input class="w-full bg-surface-container-lowest border border-outline-variant text-on-background text-body-md font-body-md rounded-DEFAULT pl-xl pr-sm py-sm outline-none transition-all duration-200 input-focused-state" id="password" name="password" placeholder="••••••••" required="" type="password" value="">
</div>
</div>
<!-- Options -->
<div class="flex items-center justify-between pt-xs">
<label class="flex items-center gap-xs cursor-pointer group">
<input class="form-checkbox h-4 w-4 text-primary border-outline-variant rounded-sm focus:ring-secondary focus:ring-offset-0 bg-surface-container-lowest" type="checkbox">
<span class="text-body-sm font-body-sm text-on-surface-variant group-hover:text-on-background transition-colors duration-200">Remember this device</span>
</label>
</div>
<!-- Error message container -->
<div id="login-error" class="hidden text-[#ba1a1a] bg-[#ffdad6] p-sm rounded border border-[#ffdad6] text-body-sm font-semibold flex items-center gap-xs">
    <span class="material-symbols-outlined text-[18px]">error</span>
    <span id="login-error-text">Invalid email or password.</span>
</div>
<!-- Submit Button -->
<button class="w-full bg-[#0F172A] hover:bg-[#1E293B] text-on-primary text-body-md font-body-md font-medium rounded-DEFAULT py-sm mt-lg transition-colors duration-200 flex justify-center items-center gap-xs shadow-sm" type="submit">
<span>Sign In</span>
<span class="material-symbols-outlined text-[20px]">arrow_forward</span>
</button>
<!-- Security Note -->
<div class="mt-lg pt-md border-t border-surface-variant flex items-center justify-center gap-xs text-on-surface-variant">
<span class="material-symbols-outlined text-[16px] text-on-tertiary-container">verified_user</span>
<span class="text-label-caps font-label-caps">End-to-end encrypted connection</span>
</div>
</form>
</div>
</div>
</div>
</div>

<!-- Screen: register -->
<div id="screen-register" class="spa-screen hidden">
<div class="min-h-full flex relative">
<!-- Decorative Background Element -->
<div class="absolute inset-0 z-0 pointer-events-none opacity-20 bg-pattern"></div>
<!-- Form Section -->
<div class="flex-1 flex flex-col justify-center px-4 py-12 sm:px-6 lg:flex-none lg:px-20 xl:px-24 z-10 bg-surface-container-lowest">
<div class="mx-auto w-full max-w-sm lg:w-96">
<div class="mb-lg">
<h2 class="text-primary font-headline-lg text-headline-lg hidden md:block tracking-tight">WealthOffice</h2>
<h2 class="text-primary font-headline-lg-mobile text-headline-lg-mobile md:hidden tracking-tight">WealthOffice</h2>
<p class="mt-2 text-on-surface-variant font-body-sm text-body-sm">Institutional Access Portal</p>
</div>
<div class="mt-8">
<div class="mt-6">
<form class="space-y-md" id="register-form" onsubmit="handleRegisterSubmit(event);" method="POST">
<div>
<label class="block font-body-sm text-body-sm font-semibold text-on-surface" for="name">Full Name</label>
<div class="mt-1">
<input autocomplete="name" class="appearance-none block w-full px-3 py-2 border border-outline-variant rounded bg-surface-container-lowest placeholder-on-surface-variant focus:outline-none focus:ring-2 focus:ring-secondary focus:border-secondary focus:ring-opacity-10 transition-colors sm:text-sm font-body-md text-body-md" id="name" name="name" required="" type="text">
</div>
</div>
<div>
<label class="block font-body-sm text-body-sm font-semibold text-on-surface" for="email">Work Email</label>
<div class="mt-1">
<input autocomplete="email" class="appearance-none block w-full px-3 py-2 border border-outline-variant rounded bg-surface-container-lowest placeholder-on-surface-variant focus:outline-none focus:ring-2 focus:ring-secondary focus:border-secondary focus:ring-opacity-10 transition-colors sm:text-sm font-body-md text-body-md" id="email" name="email" required="" type="email">
</div>
</div>
<div>
<label class="block font-body-sm text-body-sm font-semibold text-on-surface" for="firm">Firm Name</label>
<div class="mt-1">
<input autocomplete="organization" class="appearance-none block w-full px-3 py-2 border border-outline-variant rounded bg-surface-container-lowest placeholder-on-surface-variant focus:outline-none focus:ring-2 focus:ring-secondary focus:border-secondary focus:ring-opacity-10 transition-colors sm:text-sm font-body-md text-body-md" id="firm" name="firm" required="" type="text">
</div>
</div>
<div>
<label class="block font-body-sm text-body-sm font-semibold text-on-surface" for="password">Password</label>
<div class="mt-1 relative">
<input autocomplete="new-password" class="appearance-none block w-full px-3 py-2 border border-outline-variant rounded bg-surface-container-lowest placeholder-on-surface-variant focus:outline-none focus:ring-2 focus:ring-secondary focus:border-secondary focus:ring-opacity-10 transition-colors sm:text-sm font-body-md text-body-md" id="password" name="password" required="" type="password">
<button class="absolute inset-y-0 right-0 pr-3 flex items-center text-on-surface-variant hover:text-on-surface" type="button">
<span class="material-symbols-outlined text-[20px]" data-icon="visibility">visibility</span>
</button>
</div>
<p class="mt-2 font-label-caps text-label-caps text-on-surface-variant">Must be at least 12 characters with symbol.</p>
</div>
<div class="pt-sm">
<button class="w-full flex justify-center py-3 px-4 border border-transparent rounded shadow-sm text-on-primary bg-primary hover:bg-primary-container focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary font-body-md text-body-md transition-colors" type="submit">
                                    Create Account
                                </button>
</div>
</form>
</div>
</div>
<div class="mt-lg border-t border-outline-variant pt-md text-center">
<p class="font-body-sm text-body-sm text-on-surface-variant">
                        Already have institutional access? 
                        <a class="font-semibold text-secondary hover:text-secondary-container transition-colors" href="javascript:void(0)" onclick="navigateTo('login')">Sign in here.</a>
</p>
</div>
</div>
</div>
<!-- Image/Branding Section -->
<div class="hidden lg:flex lg:flex-1 relative bg-surface-container-low border-l border-outline-variant items-center justify-center p-2xl">
<div class="absolute inset-0" data-alt="A highly detailed, modern architectural abstract composition representing financial structure and security. The scene features soaring glass and steel geometric forms reflecting a clear, bright morning sky. A light-mode corporate aesthetic dominates, with stark whites, cool slate grays, and subtle accents of deep navy blue. The lighting is crisp and natural, casting sharp, intentional shadows that emphasize the rigid, precise structural framework. The overall mood is authoritative, secure, and technologically advanced, fitting for an institutional financial portal." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAIintBEdQQguQSYs5aPJscdvq24PouNqATH4GBHle3-ZnoQw9n8AXaRv7bfeoriDLhQ4dyLBWqovEMMee-Ax7Ep3O_KbtTpf2jjEdVncbPZ9FsV__A4waJTzLExWLx5nYhxcaMMSfSdkEtZ996zR7ZRdPRd5rne7Ln6XOFWXDtTcA9Nx1YhvQbnvTsk8eXZZbXi9_v-waciUBTli-8jbY2aLRxic-6UWuzMWp24439HL3lUYSH223Pbw')"></div>
<!-- Overlay Content -->
<div class="relative z-10 max-w-md bg-surface-container-lowest/90 backdrop-blur-md p-lg rounded-lg border border-outline-variant shadow-[0_10px_15px_-3px_rgba(15,23,42,0.08)]">
<div class="flex items-center gap-xs mb-sm">
<span class="material-symbols-outlined text-secondary" data-icon="security" style="font-variation-settings: 'FILL' 1;">security</span>
<h3 class="font-headline-sm text-headline-sm text-on-surface">Enterprise-Grade Security</h3>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">
                    WealthOffice employs zero-trust architecture and AES-256 encryption across all data layers, ensuring your institutional data remains strictly confidential and audit-ready.
                </p>
</div>
</div>
</div>
</div>

<!-- Screen: advisor-dashboard -->
<div id="screen-advisor-dashboard" class="spa-screen hidden">
<!-- SideNavBar -->
<nav class="hidden md:flex flex-col h-screen py-lg px-md w-64 fixed left-0 top-0 bg-surface dark:bg-inverse-surface border-r border-outline-variant dark:border-outline transition-all duration-200 ease-in-out z-20">
<div class="mb-xl flex items-center gap-sm portal-brand-header">
<img class="w-10 h-10 rounded object-cover" data-alt="WealthOffice Logo" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDcOD4IpPA9tIYNjHSIwArlikfgF2cKj9w8Vg1k67WHIz2eR7EnxfA0e0Gcl0vTzWjeMN_uKy8nAfQPlRmhB0HGmxY1M3p70V1wcT8Dzd7upQROtRlHhQ6o0Ek_7da4T2iTua4NjrIDoWdj36711MZHJYNUNEpRR3LzIUUnTa_Up4Il3wlZX6MDOKjVJqlJ7KdM58D91z_z0veiVPBI4MLIE58KRCNugezo26VgMUP_55Fn737AYsCv_Q">
<div class="portal-brand-copy">
<h1 class="portal-brand font-headline-md text-headline-md font-bold text-on-surface dark:text-inverse-on-surface">WealthOffice</h1>
<p class="portal-brand-subtitle font-body-sm text-body-sm text-on-surface-variant admin-only">Institutional Access</p>
<p class="portal-brand-subtitle font-body-sm text-body-sm text-on-surface-variant investor-only">Institutional Portal</p>
</div>
</div>
<div class="flex-grow flex flex-col gap-sm">
<a class="admin-only flex items-center gap-md px-sm py-xs rounded text-on-surface-variant hover:bg-surface-container transition-all duration-200 font-label-caps text-label-caps" href="javascript:void(0)" data-nav="dashboard" onclick="navigateTo('dashboard')">
<span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
<span>Overview</span>
</a>
<a class="investor-only flex items-center gap-md px-sm py-xs rounded text-on-surface-variant hover:bg-surface-container transition-all duration-200 font-label-caps text-label-caps" href="javascript:void(0)" data-nav="dashboard" onclick="navigateTo('dashboard')">
<span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
<span>Dashboard</span>
</a>
<a class="admin-only flex items-center gap-md px-sm py-xs rounded text-on-surface-variant hover:bg-surface-container transition-all duration-200 font-label-caps text-label-caps" href="javascript:void(0)" data-nav="investors" onclick="navigateTo('investors')">
<span class="material-symbols-outlined" data-icon="groups">groups</span>
<span>Investors</span>
</a>
<a class="flex items-center gap-md px-sm py-xs rounded text-on-surface-variant hover:bg-surface-container transition-all duration-200 font-label-caps text-label-caps" href="javascript:void(0)" data-nav="portfolio" onclick="navigateTo('portfolio')">
<span class="material-symbols-outlined" data-icon="pie_chart">pie_chart</span>
<span>Portfolio</span>
</a>
<a class="admin-only flex items-center gap-md px-sm py-xs rounded text-on-surface-variant hover:bg-surface-container transition-all duration-200 font-label-caps text-label-caps" href="javascript:void(0)" data-nav="ledger" onclick="navigateTo('ledger')">
<span class="material-symbols-outlined" data-icon="description">description</span>
<span>Reports</span>
</a>
<a class="investor-only flex items-center gap-md px-sm py-xs rounded text-on-surface-variant hover:bg-surface-container transition-all duration-200 font-label-caps text-label-caps" href="javascript:void(0)" data-nav="ledger" onclick="navigateTo('ledger')">
<span class="material-symbols-outlined" data-icon="description">description</span>
<span>Documents</span>
</a>
<a class="admin-only flex items-center gap-md px-sm py-xs rounded text-on-surface-variant hover:bg-surface-container transition-all duration-200 font-label-caps text-label-caps" href="javascript:void(0)" data-nav="analysis" onclick="navigateTo('analysis')">
<span class="material-symbols-outlined" data-icon="analytics">analytics</span>
<span>Analysis</span>
</a>
</div>
<div class="mt-auto flex flex-col gap-sm border-t border-outline-variant pt-sm">
<a class="flex items-center gap-md px-sm py-xs rounded text-on-surface-variant hover:bg-surface-container transition-all duration-200 font-label-caps text-label-caps" href="javascript:void(0)" data-nav="profile" onclick="navigateTo('profile')">
<span class="material-symbols-outlined" data-icon="person">person</span>
<span>Profile</span>
</a>
<a class="flex items-center gap-md px-sm py-xs rounded text-on-surface-variant hover:bg-surface-container transition-all duration-200 font-label-caps text-label-caps" href="javascript:void(0)" data-nav="settings" onclick="navigateTo('settings')">
<span class="material-symbols-outlined" data-icon="settings">settings</span>
<span>Settings</span>
</a>
<a class="flex items-center gap-md px-sm py-xs rounded text-on-surface-variant hover:bg-surface-container transition-all duration-200 font-label-caps text-label-caps" href="javascript:void(0)" onclick="openSupportModal()">
<span class="material-symbols-outlined" data-icon="help_outline">help_outline</span>
<span>Support</span>
</a>
<a class="flex items-center gap-md px-sm py-xs rounded text-on-surface-variant hover:bg-surface-container transition-all duration-200 font-label-caps text-label-caps" href="javascript:void(0)" onclick="signOut()">
<span class="material-symbols-outlined" data-icon="logout">logout</span>
<span>Sign Out</span>
</a>
</div>
</nav>
<!-- Main Content Area -->
<div class="flex-1 flex flex-col md:ml-64 w-full h-full overflow-hidden">
<!-- TopNavBar -->
<header class="flex justify-between items-center px-grid-margin w-full bg-surface border-b border-outline-variant w-full h-16 z-10 flex-shrink-0">
<div class="flex items-center gap-md">
<h1 class="font-headline-sm text-headline-sm font-bold text-on-surface md:hidden">WealthOffice</h1>
<!-- Search (Left) -->
<div class="hidden md:flex items-center bg-[#F1F5F9] rounded px-sm py-xs border border-[#E2E8F0]">
<span class="material-symbols-outlined text-outline text-sm mr-2" data-icon="search">search</span>
<input class="bg-transparent border-none focus:ring-0 text-body-sm font-body-sm p-0 w-64 text-on-surface outline-none" placeholder="Search..." type="text"/>
</div>
</div>
<div class="flex items-center gap-md text-primary font-body-md text-body-md">
<button class="cursor-pointer active:opacity-80 hover:bg-surface-container-low transition-colors p-2 rounded-full">
<span class="material-symbols-outlined" data-icon="notifications">notifications</span>
</button>
<button class="admin-hide cursor-pointer active:opacity-80 hover:bg-surface-container-low transition-colors p-2 rounded-full">
<span class="material-symbols-outlined" data-icon="settings">settings</span>
</button>
<img alt="User profile" class="admin-hide w-8 h-8 rounded-full object-cover border border-outline-variant ml-sm cursor-pointer" data-alt="A professional corporate headshot of a financial executive in a modern office setting. Sharp focus, bright neutral lighting, exuding trust and competence. Minimalist background." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBj2lEWpsij7VJBRJnxYY9KLPF9YULKCshUoEiXs02Bkd_kMaOyFjM2OuVeUtCuctzTJmDhOst7q-c2X9a4PuBCegH2_Ajk304E2Czu7JDiyU_BRx5PEOcXMYzds3lZ43r_JlWMy3gJ5kogZHaMJSjyWPvUqB4AhPhNchqRDx-5wrYgtVf1Pb7EXMMbCRqdaCWvyAhIJiIEpra65Y0zzxtybcqFoHaEB31J8nDrIBXlVSe1leW0PIscUw"/>
</div>
</header>
<!-- Main Canvas -->
<main class="flex-1 overflow-y-auto p-grid-margin pb-2xl">
<div class="max-w-[1440px] mx-auto space-y-lg">
<div class="flex justify-between items-end mb-xl">
<div>
<h2 class="font-headline-lg text-headline-lg text-on-surface">Overview</h2>
<p class="font-body-md text-body-md text-on-surface-variant">Key metrics and recent activity for your firm.</p>
</div>
</div>
<!-- Bento Grid Layout -->
<div class="grid grid-cols-1 md:grid-cols-12 gap-grid-gutter">
<!-- Metrics Row (Spans full width, internal grid) -->
<div class="col-span-1 md:col-span-12 grid grid-cols-1 md:grid-cols-3 gap-grid-gutter">
<!-- AUM -->
<div class="bg-level-1 rounded-lg p-md flex flex-col justify-between">
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase">Total AUM</span>
<div class="mt-sm flex items-end justify-between">
<span id="advisor-aum" class="font-data-mono text-display-lg font-semibold text-primary">$0.00</span>
<span id="advisor-aum-badge" class="font-body-sm text-body-sm text-on-surface-variant flex items-center bg-surface-container px-2 py-1 rounded">N/A</span>
</div>
</div>
<!-- Total Investors -->
<div class="bg-level-1 rounded-lg p-md flex flex-col justify-between">
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase">Total Investors</span>
<div class="mt-sm flex items-end justify-between">
<span id="advisor-total-investors" class="font-data-mono text-display-lg font-semibold text-primary">0</span>
<span id="advisor-investors-badge" class="font-body-sm text-body-sm text-on-surface-variant flex items-center bg-surface-container px-2 py-1 rounded">N/A</span>
</div>
</div>
<!-- Quarterly Growth -->
<div class="bg-level-1 rounded-lg p-md flex flex-col justify-between">
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase">Q3 Growth</span>
<div class="mt-sm flex items-end justify-between">
<span id="advisor-growth" class="font-data-mono text-display-lg font-semibold text-primary">$0.00</span>
<span id="advisor-growth-badge" class="font-body-sm text-body-sm text-on-surface-variant flex items-center bg-surface-container px-2 py-1 rounded">N/A</span>
</div>
</div>
</div>
<!-- Investor Distribution & Quick Actions -->
<div class="col-span-1 md:col-span-8 flex flex-col gap-grid-gutter">
<div class="bg-level-1 rounded-lg p-md h-[400px] flex flex-col">
<h3 class="font-label-caps text-label-caps text-on-surface-variant uppercase mb-md border-b border-[#F1F5F9] pb-xs">Investor Distribution</h3>
<div class="flex-1 flex items-center justify-center gap-lg">
<canvas id="investor-distribution-chart" width="180" height="180"></canvas>
<div id="investor-distribution-legend" class="flex flex-col gap-sm min-w-[120px]"></div>
</div>
</div>
</div>
<!-- Quick Actions Sidebar -->
<div class="col-span-1 md:col-span-4 flex flex-col gap-grid-gutter">
<div class="bg-level-1 rounded-lg p-md flex flex-col gap-md">
<h3 class="font-label-caps text-label-caps text-on-surface-variant uppercase border-b border-[#F1F5F9] pb-xs">Quick Actions</h3>
<button onclick="showAddInvestorModal()" class="bg-[#0F172A] text-white font-body-sm text-body-sm font-semibold py-sm px-md rounded flex items-center justify-center gap-sm hover:bg-[#1E293B] transition-colors w-full shadow-sm">
<span class="material-symbols-outlined text-sm">person_add</span> Add New Investor
</button>
<button onclick="generateReport()" class="bg-white text-[#0F172A] border border-[#E2E8F0] font-body-sm text-body-sm font-semibold py-sm px-md rounded flex items-center justify-center gap-sm hover:bg-slate-50 transition-colors w-full">
<span class="material-symbols-outlined text-sm">summarize</span> Generate Report
</button>
<button onclick="showRequestCapitalCallModal()" class="bg-white text-[#0F172A] border border-[#E2E8F0] font-body-sm text-body-sm font-semibold py-sm px-md rounded flex items-center justify-center gap-sm hover:bg-slate-50 transition-colors w-full">
<span class="material-symbols-outlined text-sm">account_balance_wallet</span> Request Capital Call
</button>
</div>
<!-- Recent Activities -->
<div class="bg-level-1 rounded-lg p-md flex-1 overflow-hidden flex flex-col">
<h3 class="font-label-caps text-label-caps text-on-surface-variant uppercase mb-md border-b border-[#F1F5F9] pb-xs">Recent Activities</h3>
<div class="realtime-activities-container overflow-y-auto pr-sm space-y-sm"></div>
</div>
</div>
</div>
</div>
</main>
</div>
</div>

