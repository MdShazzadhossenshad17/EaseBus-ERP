<svg id="analysis-chart-svg" class="absolute inset-0 opacity-80" height="100%" preserveAspectRatio="none" viewBox="0 0 800 300" width="100%">
<path id="analysis-chart-portfolio-line" d="M0,250 C100,200 200,280 300,150 C400,20 500,180 600,100 C700,20 750,150 800,80" fill="none" stroke="#2563EB" stroke-width="2"></path>
<path id="analysis-chart-benchmark-line" d="M0,280 C150,250 250,290 350,200 C450,110 550,220 650,160 C720,120 760,180 800,150" fill="none" stroke="#94A3B8" stroke-dasharray="5,5" stroke-width="2"></path>
</svg>
<div id="analysis-chart-tooltip" class="hidden group-hover:flex absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-primary-container text-on-primary-container text-body-sm font-body-sm p-sm rounded shadow-lg">
                        Q3 '23: Outperformed by 4.2%
                     </div>
</div>
</div>
