<!-- Modal: Add Investor -->
<div id="modal-add-investor" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-50 transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-md max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center pb-sm border-b border-outline-variant mb-md">
            <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Add New Investor</h3>
            <button onclick="closeModal('add-investor')" class="text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form id="form-add-investor" onsubmit="handleNewInvestorSubmit(event)" class="space-y-sm">
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Full Name</label>
                <input required id="new-inv-name" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="text" placeholder="e.g. Apex Partners LLC">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Investor Type</label>
                <select id="new-inv-type" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <option value="Institutional">Institutional</option>
                    <option value="Family Office">Family Office</option>
                    <option value="Retail">Retail</option>
                </select>
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Email Address</label>
                <input required id="new-inv-email" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="email" placeholder="email@domain.com">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Phone Number</label>
                <input required id="new-inv-phone" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="tel" placeholder="+1 (555) 123-4567">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Commitment Amount ($)</label>
                <input required id="new-inv-commitment" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="number" min="1" placeholder="e.g. 15000000">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Status</label>
                <select id="new-inv-status" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <option value="Active">Active</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>
            <div class="flex gap-sm pt-md border-t border-outline-variant mt-md">
                <button type="button" onclick="closeModal('add-investor')" class="flex-1 py-sm border border-outline-variant rounded font-label-caps text-label-caps text-on-surface hover:bg-surface-container-low transition-colors">Cancel</button>
                <button type="submit" class="flex-1 py-sm bg-primary text-on-primary rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Save Investor</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Add Transaction -->
<div id="modal-add-transaction" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-50 transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-md max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center pb-sm border-b border-outline-variant mb-md">
            <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Add Transaction</h3>
            <button onclick="closeModal('add-transaction')" class="text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form id="form-add-transaction" onsubmit="handleNewTransactionSubmit(event)" class="space-y-sm">
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Investor / Partner</label>
                <select id="new-tx-investor" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <!-- Populated dynamically -->
                </select>
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Transaction Type</label>
                <select id="new-tx-type" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <option value="Contribution">Contribution</option>
                    <option value="Distribution">Distribution</option>
                    <option value="Fee">Fee</option>
                </select>
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Amount ($)</label>
                <input required id="new-tx-amount" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="number" min="1" placeholder="e.g. 5000000">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Transaction Date</label>
                <input id="new-tx-date" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="date">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Description</label>
                <input id="new-tx-description" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors" type="text" placeholder="e.g. Initial Draw Call">
            </div>
            <div>
                <label class="block text-body-sm font-semibold text-on-surface-variant mb-xs">Status</label>
                <select id="new-tx-status" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                    <option value="COMPLETED">Completed</option>
                    <option value="PENDING">Pending</option>
                </select>
            </div>
            <div class="flex gap-sm pt-md border-t border-outline-variant mt-md">
                <button type="button" onclick="closeModal('add-transaction')" class="flex-1 py-sm border border-outline-variant rounded font-label-caps text-label-caps text-on-surface hover:bg-surface-container-low transition-colors">Cancel</button>
                <button type="submit" class="flex-1 py-sm bg-primary text-on-primary rounded font-label-caps text-label-caps hover:opacity-90 transition-opacity">Post Transaction</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Support -->
<div id="modal-support" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-sm hidden items-center justify-center z-50 transition-all duration-300">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-lg w-full max-w-md">
        <div class="flex justify-between items-center pb-sm border-b border-outline-variant mb-md">
