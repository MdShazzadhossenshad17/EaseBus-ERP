                    <div class="flex flex-col gap-sm">
                        <label class="block text-body-sm font-semibold text-on-surface-variant">Global Reporting Window</label>
                        <select id="global-reporting-period-select" onchange="changeReportingPeriod(this.value)" class="w-full bg-transparent border border-outline-variant rounded p-sm text-body-sm focus:border-secondary focus:outline-none transition-colors">
                            <option value="T12M">Trailing 12 Months (T12M)</option>
                            <option value="YTD">Year to Date (YTD)</option>
