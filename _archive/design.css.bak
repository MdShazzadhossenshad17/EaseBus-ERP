/* CapitalFlow - Consolidated Stylesheet (design.css) */

body {
    background-color: #F8FAFC;
    color: #0b1c30;
    transition: all 0.3s ease;
    font-family: 'Inter', sans-serif;
}

html, body { min-height: 100%; }
.spa-screen { min-height: 100vh; }
.spa-screen main { min-width: 0; }

/* Each SPA screen has its own sidebar. This keeps the product name stable
   when navigation swaps screens. */
.portal-brand {
    font-family: 'Geist', sans-serif !important;
    font-size: 1.5rem !important;
    font-weight: 700 !important;
    line-height: 2rem !important;
    letter-spacing: -0.025em !important;
}

/* All screens now share the same sidebar brand structure. Source mockups
   supplied different logos and spacing for each screen, which caused the
   top-left identity to jump whenever the SPA changed views. */
.portal-brand-header {
    display: flex !important;
    align-items: center !important;
    gap: 0.75rem !important;
    min-height: 3.25rem;
}
.portal-brand-copy { min-width: 0; }
.portal-brand-subtitle {
    display: block;
    color: #45464d !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 0.875rem !important;
    font-weight: 400 !important;
    line-height: 1.25rem !important;
}

/* Portfolio and ledger are shared screens; toggle navigation/actions by role. */
.investor-portal .admin-only { display: none !important; }
.admin-portal .investor-only { display: none !important; }
.admin-portal .admin-hide { display: none !important; }

/* Shared investor pages retain navigation on mobile after leaving the
   dashboard. The dashboard already includes its own bottom navigation. */
.investor-portal #investor-mobile-nav { display: flex !important; }
.investor-portal #screen-investor-dashboard:not(.hidden) ~ #investor-mobile-nav { display: none !important; }
.investor-portal #screen-portfolio:not(.hidden) ~ #investor-mobile-nav { display: none !important; }
.investor-portal #screen-ledger:not(.hidden) ~ #investor-mobile-nav { display: none !important; }

@media (max-width: 767px) {
    .investor-portal .spa-screen main { padding-bottom: 6.5rem !important; }
}

@media (max-width: 767px) {
    .portal-brand { font-size: 1.25rem !important; line-height: 1.75rem !important; }
    .spa-screen main { padding-left: 1rem !important; padding-right: 1rem !important; }
    .spa-screen header { padding-left: 1rem !important; padding-right: 1rem !important; }
}

/* Card & Borders UI */
.card-shadow {
    box-shadow: 0 10px 15px -3px rgba(15, 23, 42, 0.08);
}
.data-inset {
    box-shadow: inset 0 0 0 1px #E2E8F0;
    background-color: #F1F5F9;
}
.table-row-border, .table-row-divider {
    border-bottom: 1px solid #F1F5F9;
}
.card-border {
    border: 1px solid #E2E8F0;
}
.bg-level-1 {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
}
.focus-ring:focus {
    outline: none;
    border-color: #2563EB;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
}

/* Side Navigation Bar Helpers */
.nav-active-item {
    color: #0051d5;
    font-weight: bold;
    border-right: 2px solid #0051d5;
}
.nav-inactive-item {
    color: #45464d;
}

/* Dynamic Charts Styles (SVG Graphs) */
.chart-grid {
    background-size: 100% 40px;
    background-image: linear-gradient(to bottom, #F1F5F9 1px, transparent 1px);
}
.chart-line {
    fill: none;
    stroke: #2563EB;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}
.chart-area {
    fill: url(#blue-gradient);
    opacity: 0.15;
}
.chart-bar-green { fill: #00875a; }
.chart-bar-blue { fill: #0052cc; }
.chart-bar-orange { fill: #ff8c00; }
